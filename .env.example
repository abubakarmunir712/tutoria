# Env vars for docker-compose.yml — set these in Coolify's environment variables
# panel for this app (not as a committed .env file).

# Postgres reachable from the deployed container — NOT localhost. Use Coolify's
# managed Postgres service, or an external one (Neon, Supabase, etc).
DATABASE_URL="postgresql://user:password@host:5432/tutoria?schema=public"

JWT_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

QDRANT_API_URL="https://your-cluster.your-region.aws.cloud.qdrant.io"
QDRANT_API_SECRET="your-qdrant-api-key"

LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
