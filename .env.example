# Env vars for docker-compose.yml on the VPS — copy this file to `.env` at the repo
# root and fill in real values. See deploy/01-vps-setup.sh and deploy/02-deploy.sh.

# `deploy/01-vps-setup.sh` installs Postgres natively on the VPS host (not in Docker)
# and prints the exact DATABASE_URL to use here, with a generated password — paste it
# in as-is. `host.docker.internal` is how the app container reaches the host's Postgres
# (works because docker-compose.yml sets extra_hosts: host-gateway).
DATABASE_URL="postgresql://tutoria:REPLACE_ME@host.docker.internal:5432/tutoria?schema=public"

JWT_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

QDRANT_API_URL="https://your-cluster.your-region.aws.cloud.qdrant.io"
QDRANT_API_SECRET="your-qdrant-api-key"

LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
