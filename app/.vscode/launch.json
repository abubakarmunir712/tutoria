{
  // For when VS Code is opened on the app/ folder itself (the repo-root launch.json is then not
  // used). Run `scripts/dev up` first: it writes dart_defines.local.json with this machine's IP.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tutoria (local server)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=dart_defines.local.json"]
    },
    {
      "name": "Tutoria (production server)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    }
  ]
}
