PORT=3001

# Postgres connection string (student/auth/profile data)
DATABASE_URL="postgresql://user:password@localhost:5432/tutoria?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Python AI service (pipeline/src/service.py)
AI_SERVICE_URL="http://localhost:8000"

# Where profile pictures are stored on disk (a Docker volume in production)
UPLOADS_DIR="./uploads"

# Admin dashboard (admin/): its web origin(s), comma-separated. Unset = any origin outside production.
ADMIN_ORIGINS="http://localhost:5174"

# Prices behind the dashboard's estimated AI cost (defaults match gpt-4.1-mini and the gpt-4o-mini
# speech models; the AI service doesn't report real usage). All optional.
# PRICE_INPUT_PER_M_TOKENS=0.4
# PRICE_OUTPUT_PER_M_TOKENS=1.6
# PRICE_TTS_PER_CHAR=0.000015
# PRICE_STT_PER_CALL=0.003
# PRICE_VISION_PER_CALL=0.002
