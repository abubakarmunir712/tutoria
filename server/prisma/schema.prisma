generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Phase {
  UPPER_PRIMARY
  JHS
  SHS
}

enum Grade {
  B4
  B5
  B6
  B7
  B8
  B9
  SHS1
  SHS2
  SHS3
}

enum UserRole {
  PARENT
  STUDENT
}

enum SchoolType {
  PRIVATE
  PUBLIC
}

// A login. A parent signs up and adds their children; a student signs up for themselves.
model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole
  // Staff who can open the admin dashboard. Set by `npm run admin:create`, never by signup.
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students      Student[]
  refreshTokens RefreshToken[]
}

// A learner profile: one of a parent's children, or a student's own profile.
model Student {
  id             String      @id @default(uuid())
  userId         String
  name           String
  grade          Grade?
  schoolType     SchoolType?
  // The profile picture lives on disk (UPLOADS_DIR/students/<id>); these only say it exists.
  photoMime      String?
  photoUpdatedAt DateTime?
  // Left off the class leaderboard (the learner or their parent chose this).
  hideFromLeaderboard Boolean @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  stats         StudentStats?
  events        LearningEvent[]
  badges        StudentBadge[]
  usage         UsageLog[]
  quizAttempts  QuizAttempt[]
  mastery       TopicMastery[]
  submissions   AssignmentSubmission[]
  conversations Conversation[]

  @@index([userId])
}

model Subject {
  id    String @id @default(uuid())
  name  String
  phase Phase

  enrollments Enrollment[]

  @@unique([name, phase])
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  subjectId String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EventKind {
  QUESTION
  PHOTO
  VOICE
  QUIZ
  CHECK
  ASSIGNMENT
}

enum UsageKind {
  ASK
  ASK_IMAGE
  TRANSCRIBE
  SPEAK
  GRADE
}

// One thing a learner did that earned XP (a typed question, a homework photo, a spoken question).
// Quizzes and assignments will add their own kinds here.
model LearningEvent {
  id        String    @id @default(uuid())
  studentId String
  kind      EventKind
  subject   String
  topic     String?
  xp        Int
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([createdAt])
}

// Running totals for a learner, so the home screen and dashboards never have to add up events.
model StudentStats {
  studentId      String    @id
  xp             Int       @default(0)
  questions      Int       @default(0)
  photos         Int       @default(0)
  voices         Int       @default(0)
  quizzes        Int       @default(0)
  perfectQuizzes Int       @default(0)
  assignments    Int       @default(0)
  masteredTopics Int       @default(0)
  streak         Int       @default(0)
  bestStreak     Int       @default(0)
  // The last UTC calendar day (yyyy-MM-dd) with activity. Ghana is on UTC, so UTC days are
  // the learners' days.
  lastActiveDay  String?
  lastSubject    String?
  lastTopic      String?
  lastActiveAt   DateTime?
  updatedAt      DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentBadge {
  id        String   @id @default(uuid())
  studentId String
  code      String
  earnedAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, code])
}

// One call to the AI service: what it was, how big, and what it probably cost. The admin
// dashboard's cost and usage figures come from here.
model UsageLog {
  id          String    @id @default(uuid())
  studentId   String?
  kind        UsageKind
  subject     String?
  inputChars  Int       @default(0)
  outputChars Int       @default(0)
  // An estimate from sizes and configured prices; the AI service does not report real usage.
  costUsd     Float     @default(0)
  ok          Boolean   @default(true)
  durationMs  Int       @default(0)
  createdAt   DateTime  @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([studentId, createdAt])
}

// Admin-editable knobs (rate limits), stored as text.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------------------------
// Practice units: quizzes, quick checks (diagnostics), assignments and topic mastery. Loaded from
// the consultant's knowledge base by `npm run quiz:seed` (see docs/QUIZ_PLAN.md).
// ---------------------------------------------------------------------------------------------

enum QuizMode {
  QUIZ
  CHECK
}

enum QuestionLevel {
  FOUNDATIONAL
  UNDERSTANDING
  APPLICATION
  REASONING
  TRANSFER
}

enum Verdict {
  CORRECT
  PARTIAL
  INCORRECT
}

// The progression map's states: Not Started -> Emerging -> Developing -> Secure -> Mastered, with
// Needs Revision for a learner who slips back. "Not started" is the absence of a row.
enum MasteryState {
  EMERGING
  DEVELOPING
  SECURE
  MASTERED
  NEEDS_REVISION
}

model QuizTopic {
  id                     String @id @default(uuid())
  // The pack's record id, e.g. TUT-001. Stable, so re-seeding updates in place.
  code                   String @unique
  grade                  Grade
  subject                String
  name                   String
  strand                 String
  term                   String
  week                   Int
  // Position within the grade + subject, in teaching order.
  order                  Int
  previousLearning       String
  nextLearning           String
  remediation            String
  alternativeExplanation String
  prerequisiteRevision   String
  likelyMisconception    String
  assignmentTask         String
  assignmentCriteria     String
  assignmentReflection   String

  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  mastery     TopicMastery[]
  submissions AssignmentSubmission[]

  @@index([grade, subject, order])
}

model QuizQuestion {
  id                String        @id @default(uuid())
  topicId           String
  order             Int
  level             QuestionLevel
  difficulty        Int
  question          String
  expectedAnswer    String
  variations        String
  commonWrongAnswer String
  misconception     String
  workedSolution    String
  rubric            String
  // Also one of the topic's three diagnostic items.
  diagnostic        Boolean       @default(false)

  topic   QuizTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([topicId, order])
}

model QuizAttempt {
  id         String    @id @default(uuid())
  studentId  String
  topicId    String
  mode       QuizMode
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // 0..1 once finished.
  score      Float?
  xp         Int       @default(0)

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   QuizTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([studentId, topicId])
  @@index([finishedAt])
}

model QuizAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  // The learner's final answer, and how many tries it took (1 or 2).
  answer     String
  tries      Int      @default(1)
  verdict    Verdict
  points     Float
  feedback   String   @default("")
  // Whether the AI service graded it (false: exact match, or the keyword fallback).
  aiGraded   Boolean  @default(false)
  // False after a wrong first try (the child may try once more); true when the question is done.
  settled    Boolean  @default(false)
  createdAt  DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model TopicMastery {
  studentId      String
  topicId        String
  state          MasteryState
  attempts       Int          @default(0)
  bestScore      Float        @default(0)
  lastScore      Float        @default(0)
  // How many attempts so far scored 80% or more (Mastered needs two).
  strongAttempts Int          @default(0)
  lastAttemptAt  DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   QuizTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([studentId, topicId])
  @@index([topicId])
}

model AssignmentSubmission {
  id         String   @id @default(uuid())
  studentId  String
  topicId    String
  response   String
  reflection String   @default("")
  verdict    Verdict
  feedback   String   @default("")
  xp         Int      @default(0)
  createdAt  DateTime @default(now())

  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   QuizTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([studentId, topicId])
}

// ---------------------------------------------------------------------------------------------
// Tutor chat history, so a learner can come back to a conversation and carry on.
// ---------------------------------------------------------------------------------------------

enum ChatRole {
  USER
  ASSISTANT
}

model Conversation {
  id            String   @id @default(uuid())
  studentId     String
  subject       String
  grade         String?
  topic         String?
  // The first thing the learner asked, trimmed: what the history list shows.
  title         String
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([studentId, lastMessageAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           ChatRole
  content        String
  // A homework photo was sent with this message (the photo itself is not kept).
  hasImage       Boolean  @default(false)
  // Curriculum references that came with a tutor answer, as the app shows them.
  citations      Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
